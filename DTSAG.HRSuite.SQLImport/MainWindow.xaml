<Window x:Class="DTSAG.HRSuite.SQLImport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DTSAG.HRSuite.SQLImport.ViewModels"
        mc:Ignorable="d"
        Title="DTSAG HRSuite – SQL Import"
        Height="720" Width="1120"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Accent color -->
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#005A9E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#666666"/>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#0078D4"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Standard button -->
        <Style x:Key="StdButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primary (blue) button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource StdButton}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005A9E"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAAAAA"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Placeholder overlay helper -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="#F3F3F3">

        <!-- ── Status bar ─────────────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom" Background="#E0E0E0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <StatusBarItem Padding="6,3">
                <TextBlock Text="{Binding ImportStatus}" Foreground="#333333"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Padding="6,3">
                <ProgressBar Width="120" Height="10"
                             IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Main tab control ───────────────────────────────────────── -->
        <TabControl Margin="8" Background="White" BorderBrush="#DDDDDD">

            <!-- ════════════════════════════════════════════════════════════
                 TAB 1: Import
                 ════════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="  Import  " FontSize="13" Padding="4,2"/>
                </TabItem.Header>

                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" MinWidth="160"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Left: Table list ───────────────────────────── -->
                    <DockPanel Grid.Column="0">

                        <TextBlock DockPanel.Dock="Top" Text="Tabellen" Style="{StaticResource SectionHeader}"/>

                        <!-- Toolbar: search + load -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right"
                                    Content="Laden"
                                    Command="{Binding LoadTablesCommand}"
                                    Style="{StaticResource StdButton}"
                                    Margin="4,0,0,0" Padding="8,4"/>
                            <Grid>
                                <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" Padding="4,3"/>
                                <TextBlock Text="Tabelle suchen…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TableSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>

                        <!-- Table list -->
                        <ListBox ItemsSource="{Binding FilteredTables}"
                                 SelectedItem="{Binding SelectedTable}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 BorderBrush="#DDDDDD">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Padding="2,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- ── Splitter ───────────────────────────────────── -->
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                                  Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>

                    <!-- ── Right: CSV + Mapping ───────────────────────── -->
                    <DockPanel Grid.Column="2" Margin="8,0,0,0">

                        <!-- CSV file row -->
                        <Border DockPanel.Dock="Top"
                                Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CSV-Datei:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CsvFilePath, Mode=OneWay}"
                                         IsReadOnly="True" VerticalContentAlignment="Center"
                                         Background="#F5F5F5" Padding="4,3"/>
                                <Button Grid.Column="2" Content="Durchsuchen…"
                                        Command="{Binding BrowseCsvCommand}"
                                        Style="{StaticResource StdButton}" Margin="6,0,0,0"/>
                                <Button Grid.Column="3" Content="Neu laden"
                                        Command="{Binding ReloadCsvCommand}"
                                        Style="{StaticResource StdButton}" Margin="4,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="Trennzeichen:" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                <ComboBox Grid.Column="5" Width="130"
                                          ItemsSource="{Binding DelimiterOptions}"
                                          DisplayMemberPath="Key"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Delimiter}"/>
                            </Grid>
                        </Border>

                        <!-- Mapping toolbar -->
                        <Border DockPanel.Dock="Top"
                                Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                CornerRadius="3" Padding="8,6" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="  Importieren  "
                                        Command="{Binding ImportCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                                <CheckBox DockPanel.Dock="Right"
                                          IsChecked="{Binding UpdateExisting}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          Cursor="Hand"
                                          ToolTip="Vorhandene Zeilen per SQL MERGE aktualisieren. Schlüsselspalten in der Tabelle unten markieren.">
                                    <TextBlock Text="Vorhandene Zeilen aktualisieren">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateExisting}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#0078D4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </CheckBox>
                                <Button DockPanel.Dock="Right"
                                        Content="Auto-Mapping"
                                        Command="{Binding AutoMapCommand}"
                                        Style="{StaticResource StdButton}" Margin="0,0,8,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Zieltabelle: " Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock Text="{Binding SelectedTable}" FontWeight="SemiBold"
                                               Foreground="#0078D4"
                                               FontFamily="Consolas"/>
                                    <TextBlock Text=" (keine Tabelle ausgewählt)"
                                               Foreground="{StaticResource MutedBrush}" FontStyle="Italic">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTable}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Column mapping DataGrid -->
                        <DataGrid ItemsSource="{Binding ColumnMappings}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F7F9FF"
                                  BorderBrush="#DDDDDD"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  IsReadOnly="False">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="BorderBrush" Value="#DDDDDD"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>

                                <!-- DB Column -->
                                <DataGridTextColumn Header="DB-Spalte"
                                                    Binding="{Binding DbColumn}"
                                                    IsReadOnly="True" Width="190">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Data type -->
                                <DataGridTextColumn Header="Datentyp"
                                                    Binding="{Binding DbColumnType}"
                                                    IsReadOnly="True" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#555555"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Nullable -->
                                <DataGridTemplateColumn Header="Nullable" Width="70" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="✗"/>
                                                        <Setter Property="Foreground" Value="#CC0000"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNullable}" Value="True">
                                                                <Setter Property="Text" Value="✓"/>
                                                                <Setter Property="Foreground" Value="#007700"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Key column (used for MERGE ON clause) -->
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.Header>
                                        <StackPanel Orientation="Horizontal" ToolTip="Schlüsselspalten zur Identifikation vorhandener Zeilen (MERGE ON). Nur relevant wenn 'Vorhandene Zeilen aktualisieren' aktiv.">
                                            <TextBlock Text="Schlüssel"/>
                                        </StackPanel>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Cursor="Hand">
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.UpdateExisting,
                                                                RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                         Value="False">
                                                                <Setter Property="Opacity" Value="0.35"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CSV column mapping (ComboBox always visible) -->
                                <DataGridTemplateColumn Header="CSV-Spalte (Mapping)" Width="*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox
                                                ItemsSource="{Binding DataContext.CsvHeadersWithIgnore,
                                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                SelectedItem="{Binding CsvColumn, UpdateSourceTrigger=PropertyChanged}"
                                                Padding="6,3" Margin="4,2"
                                                BorderThickness="1" BorderBrush="#CCCCCC"
                                                Background="White"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════════
                 TAB 2: Einstellungen
                 ════════════════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="  Einstellungen  " FontSize="13" Padding="4,2"/>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F3F3">
                    <StackPanel Margin="20,16" MaxWidth="580">

                        <!-- ── Server ──────────────────────────────────── -->
                        <GroupBox Margin="0,0,0,14" Padding="12,10">
                            <GroupBox.Header>
                                <TextBlock Text="Server" FontWeight="SemiBold" FontSize="13"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Gespeicherte Server:" Margin="0,0,0,4" Foreground="#555"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding Servers}"
                                              SelectedItem="{Binding SelectedServer}"
                                              IsEditable="True"
                                              Text="{Binding SelectedServer, UpdateSourceTrigger=PropertyChanged}"
                                              Padding="6,4"/>
                                    <Button Grid.Column="1" Content="Entfernen"
                                            Command="{Binding RemoveServerCommand}"
                                            Style="{StaticResource StdButton}" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Server hinzufügen:" Margin="0,0,0,4" Foreground="#555"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewServer, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" Padding="6,4"/>
                                    <Button Grid.Column="1" Content="Hinzufügen"
                                            Command="{Binding AddServerCommand}"
                                            Style="{StaticResource StdButton}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Authentifizierung ───────────────────────── -->
                        <GroupBox Margin="0,0,0,14" Padding="12,10">
                            <GroupBox.Header>
                                <TextBlock Text="Authentifizierung" FontWeight="SemiBold" FontSize="13"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <RadioButton Content="Windows-Authentifizierung (NT Auth)"
                                             IsChecked="{Binding UseNtAuth}"
                                             GroupName="AuthMode"
                                             Margin="0,0,0,8" Padding="4,2"/>
                                <RadioButton Content="SQL Server-Authentifizierung"
                                             IsChecked="{Binding UseSqlAuth}"
                                             GroupName="AuthMode"
                                             Margin="0,0,0,8" Padding="4,2"/>

                                <!-- SQL Auth credentials (shown only when SQL auth selected) -->
                                <Border Margin="20,4,0,0" Padding="12,10"
                                        Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1"
                                        CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseNtAuth}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Benutzername:"
                                                   VerticalAlignment="Center" Foreground="#555"/>
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Passwort:"
                                                   VerticalAlignment="Center" Foreground="#555"/>
                                        <PasswordBox Grid.Row="2" Grid.Column="1"
                                                     x:Name="PwdBox" Padding="6,4"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Datenbank ───────────────────────────────── -->
                        <GroupBox Margin="0,0,0,14" Padding="12,10">
                            <GroupBox.Header>
                                <TextBlock Text="Datenbank" FontWeight="SemiBold" FontSize="13"/>
                            </GroupBox.Header>
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding Databases}"
                                              SelectedItem="{Binding SelectedDatabase}"
                                              Padding="6,4"/>
                                    <Button Grid.Column="1" Content="Verbinden"
                                            Command="{Binding LoadDatabasesCommand}"
                                            Style="{StaticResource StdButton}" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding ConnectionStatus}"
                                           Foreground="#555" FontStyle="Italic" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ── Save button ────────────────────────────── -->
                        <Button Content="  Einstellungen speichern  "
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
