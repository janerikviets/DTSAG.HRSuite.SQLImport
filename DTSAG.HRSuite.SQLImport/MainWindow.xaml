<Window x:Class="DTSAG.HRSuite.SQLImport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DTSAG.HRSuite.SQLImport.ViewModels"
        mc:Ignorable="d"
        Title="DTSAG HRSuite – SQL Import"
        Height="768" Width="1280"
        MinHeight="540" MinWidth="860"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- ── Sidebar nav button ─────────────────────────────── -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D7D7D7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#5FFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ── Primary button ────────────────────────────────── -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#041737"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#cc171a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button ──────────────────────────────── -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F4FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#A0B8E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Form controls ─────────────────────────────────── -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <!-- ── Card ──────────────────────────────────────────── -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4EAF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#041737"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- DataGrid header -->
        <Style x:Key="DgHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F4FF"/>
            <Setter Property="Foreground" Value="#041737"/>
            <Setter Property="BorderBrush" Value="#DCE6F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             SIDEBAR
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#041737">
            <DockPanel>

                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,22,16,18">
                    <StackPanel>
                        <TextBlock Text="DTSAG" Foreground="White"
                                   FontSize="18" FontWeight="Bold" LineHeight="20"/>
                        <TextBlock Text="SQL Import" Foreground="#B3D4FF"
                                   FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Border DockPanel.Dock="Top" Height="1"
                        Background="#1AFFFFFF" Margin="16,0,16,10"/>

                <!-- Nav items -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0">
                    <Button x:Name="BtnNavImport"
                            Content="📥  Import"
                            Style="{StaticResource NavButtonActiveStyle}"
                            Click="BtnNavImport_Click"/>
                    <Button x:Name="BtnNavSettings"
                            Content="⚙️  Einstellungen"
                            Style="{StaticResource NavButtonStyle}"
                            Click="BtnNavSettings_Click"/>
                </StackPanel>

                <!-- Version -->
                <Border DockPanel.Dock="Bottom" Padding="20,12">
                    <TextBlock Text="v1.0" Foreground="#3A4A60" FontSize="11"/>
                </Border>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             CONTENT AREA
             ══════════════════════════════════════════════════════ -->
        <DockPanel Grid.Column="1" Background="#F5F7FA">

            <!-- Page header bar -->
            <Border DockPanel.Dock="Top"
                    Background="#F0F4FF"
                    BorderBrush="#C8D8FF" BorderThickness="0,0,0,1"
                    Height="52">
                <DockPanel Margin="24,0">
                    <TextBlock x:Name="PageTitle"
                               DockPanel.Dock="Left"
                               Text="Import"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="#041737"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <ProgressBar Width="90" Height="5" Margin="0,0,10,0"
                                     IsIndeterminate="True"
                                     Foreground="#041737" Background="#D0DEFF"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding ImportStatus}"
                                   FontSize="12" Foreground="#555"
                                   VerticalAlignment="Center"
                                   MaxWidth="440" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- View container: Import + Settings share this cell -->
            <Grid>

                <!-- ════════════════════════════════════════════════
                     VIEW: IMPORT
                     ════════════════════════════════════════════════ -->
                <Grid x:Name="ViewImport" Margin="20,16,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" MinWidth="160"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Table card -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tabellen"
                                       Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10"/>
                            <Button DockPanel.Dock="Top"
                                    Content="Tabellen laden"
                                    Command="{Binding LoadTablesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"/>
                            <!-- Search with placeholder -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0" Padding="8,6,8,6"/>
                                <TextBlock IsHitTestVisible="False" Text="Tabelle suchen…"
                                           Foreground="#BBBBBB" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TableSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <!-- Table list -->
                            <ListBox ItemsSource="{Binding FilteredTables}"
                                     SelectedItem="{Binding SelectedTable}"
                                     BorderThickness="1" BorderBrush="#E4EAF4"
                                     Background="White"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Padding="2,1"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E4EDFF"/>
                                                <Setter Property="Foreground" Value="#041737"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F5FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right: CSV + Mapping -->
                    <DockPanel Grid.Column="2">

                        <!-- CSV row card -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CSV-Datei:"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FormLabelStyle}"
                                           Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding CsvFilePath, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Margin="0" Background="#F8F9FB"/>
                                <Button Grid.Column="2" Content="Durchsuchen…"
                                        Command="{Binding BrowseCsvCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"/>
                                <Button Grid.Column="3" Content="Neu laden"
                                        Command="{Binding ReloadCsvCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="Trennzeichen:"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FormLabelStyle}"
                                           Margin="18,0,8,0"/>
                                <ComboBox Grid.Column="5" Width="130"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          Margin="0"
                                          ItemsSource="{Binding DelimiterOptions}"
                                          DisplayMemberPath="Key"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Delimiter}"/>
                            </Grid>
                        </Border>

                        <!-- Toolbar card -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="  Importieren  "
                                        Command="{Binding ImportCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                                <CheckBox DockPanel.Dock="Right"
                                          IsChecked="{Binding UpdateExisting}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,16,0" Cursor="Hand" FontSize="13"
                                          ToolTip="SQL MERGE: Vorhandene Zeilen per Schlüsselspalte aktualisieren">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Vorhandene Zeilen aktualisieren"/>
                                                <Setter Property="Foreground" Value="#555"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateExisting}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#041737"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </CheckBox>
                                <Button DockPanel.Dock="Right"
                                        Content="Auto-Mapping"
                                        Command="{Binding AutoMapCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Zieltabelle: " Foreground="#888" FontSize="13"/>
                                    <TextBlock Text="{Binding SelectedTable}"
                                               FontWeight="SemiBold" Foreground="#041737"
                                               FontFamily="Consolas" FontSize="13"/>
                                    <TextBlock Foreground="#BBB" FontStyle="Italic" FontSize="13"
                                               Text="(keine Tabelle gewählt)">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedTable}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Mapping DataGrid card (fills remaining height) -->
                        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0">
                            <DataGrid ItemsSource="{Binding ColumnMappings}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8FAFF"
                                      HorizontalGridLinesBrush="#EEF1F8"
                                      BorderThickness="0"
                                      ColumnHeaderStyle="{StaticResource DgHeaderStyle}"
                                      IsReadOnly="False">
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="DB-Spalte"
                                                        Binding="{Binding DbColumn}"
                                                        IsReadOnly="True" Width="185">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="12,6"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Datentyp"
                                                        Binding="{Binding DbColumnType}"
                                                        IsReadOnly="True" Width="105">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#666"/>
                                                <Setter Property="Padding" Value="12,6"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Nullable" Width="70" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✗"/>
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNullable}" Value="True">
                                                                    <Setter Property="Text" Value="✓"/>
                                                                    <Setter Property="Foreground" Value="#27AE60"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="72"
                                        ToolTip="Schlüsselspalten für MERGE ON (nur bei 'Vorhandene Zeilen aktualisieren')">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="Schlüssel" FontSize="12"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Cursor="Hand">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.UpdateExisting,
                                                                    RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                             Value="False">
                                                                    <Setter Property="Opacity" Value="0.3"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="CSV-Spalte (Mapping)" Width="*" MinWidth="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox
                                                    ItemsSource="{Binding DataContext.CsvHeadersWithIgnore,
                                                        RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    SelectedItem="{Binding CsvColumn, UpdateSourceTrigger=PropertyChanged}"
                                                    Padding="8,4" Margin="6,3"
                                                    BorderThickness="1" BorderBrush="#CCCCCC"
                                                    Background="White" FontSize="13"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                    </DockPanel>
                </Grid>

                <!-- ════════════════════════════════════════════════
                     VIEW: EINSTELLUNGEN
                     ════════════════════════════════════════════════ -->
                <ScrollViewer x:Name="ViewSettings"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              Background="#F5F7FA">
                    <StackPanel Margin="20,16,20,24" MaxWidth="560">

                        <!-- Server card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Server" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Gespeicherte Server" Style="{StaticResource FormLabelStyle}"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              Margin="0"
                                              ItemsSource="{Binding Servers}"
                                              SelectedItem="{Binding SelectedServer}"
                                              IsEditable="True"
                                              Text="{Binding SelectedServer, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Entfernen"
                                            Command="{Binding RemoveServerCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Server hinzufügen" Style="{StaticResource FormLabelStyle}"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Margin="0"
                                             Text="{Binding NewServer, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Hinzufügen"
                                            Command="{Binding AddServerCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Auth card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Authentifizierung" Style="{StaticResource CardTitleStyle}"/>
                                <RadioButton Content="Windows-Authentifizierung (NT Auth)"
                                             IsChecked="{Binding UseNtAuth}"
                                             GroupName="AuthMode"
                                             FontSize="14" Padding="4,2"
                                             Margin="0,0,0,10" Cursor="Hand"/>
                                <RadioButton Content="SQL Server-Authentifizierung"
                                             IsChecked="{Binding UseSqlAuth}"
                                             GroupName="AuthMode"
                                             FontSize="14" Padding="4,2"
                                             Margin="0,0,0,14" Cursor="Hand"/>

                                <!-- SQL credentials (hidden for NT Auth) -->
                                <Border Padding="16,14"
                                        Background="#F8FAFF"
                                        BorderBrush="#DCE6F5" BorderThickness="1"
                                        CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseNtAuth}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="Benutzername" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                                 Margin="0,4,0,12"
                                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="Passwort" Style="{StaticResource FormLabelStyle}"/>
                                        <PasswordBox x:Name="PwdBox"
                                                     Style="{StaticResource FormPasswordBoxStyle}"
                                                     Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Database card -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Datenbank" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Verfügbare Datenbanken" Style="{StaticResource FormLabelStyle}"/>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              Margin="0"
                                              ItemsSource="{Binding Databases}"
                                              SelectedItem="{Binding SelectedDatabase}"/>
                                    <Button Grid.Column="1" Content="Verbinden"
                                            Command="{Binding LoadDatabasesCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding ConnectionStatus}"
                                           FontSize="12" Foreground="#555"
                                           FontStyle="Italic" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Save -->
                        <Button Content="  Einstellungen speichern  "
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"/>

                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
